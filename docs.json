{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "The Buoy API",
  "colors": {
    "primary": "#6B55F6",
    "light": "#FFF869",
    "dark": "#030310"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:thomas@thesurfkit.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Access",
      "href": "mailto:api-support@thesurfkit.com?subject=Buoy%20API%20Access%20Request"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "authentication",
              "quickstart"
            ]
          },
          {
            "group": "Use Cases",
            "pages": [
              "guides/country-buoys",
              "guides/last-readings",
              "guides/rate-limits"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "../mintlify-openapi.json"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Reference",
          "href": "/api-reference/introduction",
          "icon": "code"
        },
        {
          "anchor": "Support",
          "href": "mailto:api-support@thesurfkit.com",
          "icon": "envelope"
        }
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "mcp"
    ]
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  },
  "background": {
    "color": {
      "dark": "#030310"
    },
    "decoration": "grid"
  }
}
