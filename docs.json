{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "The Buoy API",
  "colors": {
    "primary": "#0369A1",
    "light": "#38BDF8",
    "dark": "#075985"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:api-support@thesurfkit.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Access",
      "href": "mailto:api-support@thesurfkit.com?subject=Buoy%20API%20Access%20Request"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "authentication",
              "quickstart"
            ]
          },
          {
            "group": "Use Cases",
            "pages": [
              "guides/country-buoys",
              "guides/last-readings",
              "guides/rate-limits"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Reference",
          "href": "/api-reference/introduction",
          "icon": "code"
        },
        {
          "anchor": "Support",
          "href": "mailto:api-support@thesurfkit.com",
          "icon": "envelope"
        }
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/thesurfkit"
    }
  }
}
